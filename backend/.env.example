PORT=5000
NODE_ENV=development

# PostgreSQL connection. For Neon, use the pooled connection string with ?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/hrms_db

# Long random string — signs access tokens and hashes refresh tokens / OTPs
JWT_SECRET=change-me-to-a-long-random-string

# CORS: the frontend's origin
# Base of links in emails (activation links). Set to your live site in production.
FRONTEND_URL=http://localhost:3000
# Activation links (admin invitations) expire after this many hours
INVITE_TTL_HOURS=48
# Proxies in front of this server. Set 1 when the Next.js frontend (frontendnext)
# forwards /api here, so rate limits see each visitor's real IP.
TRUST_PROXY=0
# strict (default) | lax | none — use none (HTTPS only) if frontend and API are on different sites
COOKIE_SAMESITE=strict

# Razorpay (https://dashboard.razorpay.com/app/keys). Billing stays off until these are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From `npm run setup-billing`
RAZORPAY_PLAN_ID=
# From the webhook you create pointing to https://<your-backend-domain>/api/billing/webhook
RAZORPAY_WEBHOOK_SECRET=

# ImageKit (https://imagekit.io/dashboard/developer/api-keys) — image uploads
# (company logos, check-in photos). Uploads are off until these are set.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_FOLDER=/sangvya

# Pricing
PRICE_PER_EMPLOYEE=15
TRIAL_DAYS=14

# Attendance rules
APP_TIMEZONE=Asia/Kolkata
REQUIRED_WORK_HOURS=9
MAX_BREAK_MINUTES=60
COMP_OFF_VALID_DAYS=90

# Email (manager attendance alerts, password reset OTP). Leave SMTP_HOST empty to print emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Login sessions: short access token + rotating refresh token
ACCESS_TOKEN_TTL_MIN=5
SESSION_IDLE_MIN=20
SESSION_MAX_HOURS=12



#image kit creds
IMAGEKIT_PUBLIC_KEY=...
IMAGEKIT_PRIVATE_KEY=...
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
